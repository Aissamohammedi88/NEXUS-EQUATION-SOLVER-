#!/bin/bash# ═══════════════════════════════════════════════════════════════════════════
# NEXUS EQUATION SOLVER v3.0.0 — Vérifie + Calcule + Équation + Solution
# Auteur : Aissa Mohammedi (DGK) — NEXUS-OPEN-2.0
#
# Ce script :
# 1. VÉRIFIE les données d'entrée
# 2. CALCULE Γ, ρ, ζ
# 3. GÉNÈRE l'équation exacte
# 4. DONNE la solution pour que ça marche
# ═══════════════════════════════════════════════════════════════════════════

set -uo pipefail

VERSION="3.0.0"
AUTEUR="Aissa Mohammedi (DGK)"
BASE="$HOME/Documents/nexus_equation"
REPORT_DIR="$BASE/reports"
mkdir -p "$BASE" "$REPORT_DIR"

# Couleurs
if [ -t 1 ]; then
G='\033[0;32m'; R='\033[0;31m'; Y='\033[1;33m'; B='\033[0;36m'
M='\033[0;35m'; C='\033[1;36m'; W='\033[1;37m'; N='\033[0m'
else
G=''; R=''; Y=''; B=''; M=''; C=''; W=''; N=''
fi

info() { printf "${B}[INFO]${N} %s\n" "$1"; }
ok() { printf "${G}[ OK ]${N} %s\n" "$1"; }
warn() { printf "${Y}[WARN]${N} %s\n" "$1"; }
err() { printf "${R}[FAIL]${N} %s\n" "$1"; }

# ───────────────────────────────────────────────────────────────────────────
# FORMATAGE
# ───────────────────────────────────────────────────────────────────────────
fmt() { awk -v n="$1" -v d="${2:-2}" 'BEGIN { printf "%.*f", d, n }' 2>/dev/null || echo "0"; }
fmt2() { fmt "$1" 2; }
fmt4() { fmt "$1" 4; }
fmt6() { fmt "$1" 6; }

# ───────────────────────────────────────────────────────────────────────────
# MATH
# ───────────────────────────────────────────────────────────────────────────
calc() { echo "scale=6; $1" | bc -l 2>/dev/null | tr -d '\n'; }
calc_div() {
local a="$1" b="$2"
if [ "$(echo "$b == 0" | bc)" = "1" ]; then echo "0"; else calc "$a / $b"; fi
}
calc_mul() { calc "$1 * $2"; }

# ───────────────────────────────────────────────────────────────────────────
# ÉTAPE 1 — DONNÉES D'ENTRÉE
# ───────────────────────────────────────────────────────────────────────────
echo ""
echo "═══════════════════════════════════════════════════════════════════════════"
echo " 🧬 NEXUS EQUATION SOLVER v$VERSION"
echo " Auteur : $AUTEUR"
echo "═══════════════════════════════════════════════════════════════════════════"
echo ""

printf "${C}═══ ÉTAPE 1 : VÉRIFICATION DES DONNÉES ═══${N}\n"
echo ""

# Données d'entrée (modifiables)
TAILLE_BRUTE=56000
TOKENS_ORIG=8000
TOKENS_CONSERVES=4000
TAILLE_FINALE=32000

# Prix marché
PRIX_SIGNAL_1K=0.05
PRIX_GEMINI_CACHE_1M=0.125
PRIX_GEMINI_INPUT_1M=1.25
PRIX_DEEPSEEK_CACHE_1M=0.0028
VOLUME_JOUR=1000000

# Vérifications
printf " Taille brute : %s octets " "$TAILLE_BRUTE"
[ "$TAILLE_BRUTE" -gt 0 ] && printf "${G}✅${N}\n" || printf "${R}❌${N}\n"

printf " Tokens originaux : %s " "$TOKENS_ORIG"
[ "$TOKENS_ORIG" -gt 0 ] && printf "${G}✅${N}\n" || printf "${R}❌${N}\n"

printf " Tokens conservés : %s " "$TOKENS_CONSERVES"
[ "$TOKENS_CONSERVES" -gt 0 ] && printf "${G}✅${N}\n" || printf "${R}❌${N}\n"

printf " Ratio compression : %sx " "$(calc_div "$TOKENS_ORIG" "$TOKENS_CONSERVES")"
[ "$TOKENS_CONSERVES" -lt "$TOKENS_ORIG" ] && printf "${G}✅${N}\n" || printf "${R}❌${N}\n"

echo ""

# ───────────────────────────────────────────────────────────────────────────
# ÉTAPE 2 — CALCUL DES MÉTRIQUES
# ───────────────────────────────────────────────────────────────────────────
printf "${C}═══ ÉTAPE 2 : CALCUL DES MÉTRIQUES ═══${N}\n"
echo ""

# Γ (Gamma) = ratio de compression
GAMMA=$(calc_div "$TOKENS_ORIG" "$TOKENS_CONSERVES")
printf " Γ (Gamma) = Tokens_orig / Tokens_final = %s / %s = ${W}%s${N}\n" \
"$TOKENS_ORIG" "$TOKENS_CONSERVES" "$(fmt4 "$GAMMA")"
echo ""

# ρ (Rho) = densité sémantique
RHO=$(calc_div "$TOKENS_CONSERVES" "$TAILLE_FINALE")
printf " ρ (Rho) = Tokens_final / Taille_finale = %s / %s = ${W}%s${N}\n" \
"$TOKENS_CONSERVES" "$TAILLE_FINALE" "$(fmt6 "$RHO")"
echo ""

# Efficience (ζ)
EFFICIENCE=174
ZETA=$(calc_div "$EFFICIENCE" "100")
printf " ζ (Zeta) = Efficience / 100 = %s / 100 = ${W}%s${N}\n" \
"$EFFICIENCE" "$(fmt4 "$ZETA")"
echo ""

# Signal pur
SEUIL_SEM=0.85
SIGNAL_PUR=$(calc_mul "$(calc_mul "$TOKENS_ORIG" "$(calc_div 1 "$GAMMA")")" "$SEUIL_SEM")
printf " S_pur = Tokens_orig × (1/Γ) × Seuil = %s × (1/%s) × %s = ${W}%s${N}\n" \
"$TOKENS_ORIG" "$(fmt2 "$GAMMA")" "$SEUIL_SEM" "$(fmt2 "$SIGNAL_PUR")"
echo ""

# Coût du signal brut
COUT_SIGNAL_1M=$(calc_mul "$PRIX_SIGNAL_1K" "1000")
printf " Coût signal = Prix_1k × 1000 = \$%s × 1000 = ${W}\$%s / 1M${N}\n" \
"$PRIX_SIGNAL_1K" "$(fmt2 "$COUT_SIGNAL_1M")"
echo ""

# ───────────────────────────────────────────────────────────────────────────
# ÉTAPE 3 — ÉQUATION À APPLIQUER
# ───────────────────────────────────────────────────────────────────────────
printf "${C}═══ ÉTAPE 3 : ÉQUATION À APPLIQUER ═══${N}\n"
echo ""

echo " ┌─────────────────────────────────────────────────────────────────┐"
echo " │ ÉQUATION MAÎTRESSE DU SIGNAL │"
echo " │ │"
echo " │ S_pur = Tokens_orig × (1/Γ) × Seuil_sémantique │"
echo " │ │"
echo " │ où : │"
echo " │ Γ = ratio de compression = Tokens_orig / Tokens_final │"
echo " │ Seuil = seuil sémantique (0.85 par défaut) │"
echo " │ │"
echo " └─────────────────────────────────────────────────────────────────┘"
echo ""

echo " ┌─────────────────────────────────────────────────────────────────┐"
echo " │ ÉQUATION DE RENTABILITÉ │"
echo " │ │"
echo " │ Profit = Revenu - Coût │"
echo " │ │"
echo " │ Revenu = Volume_jour × Prix_token × Efficience │"
echo " │ Coût = Volume_jour × Prix_1k / 1000 + GPU + Électricité │"
echo " │ │"
echo " └─────────────────────────────────────────────────────────────────┘"
echo ""

echo " ┌─────────────────────────────────────────────────────────────────┐"
echo " │ ÉQUATION DE VÉRITÉ (Gemini vs Signal brut) │"
echo " │ │"
echo " │ Écart = Coût_signal_brut / Coût_gemini_cache │"
echo " │ │"
echo " │ Si Écart > 1 → Signal brut plus cher → NE PAS ACHETER │"
echo " │ Si Écart < 1 → Signal brut moins cher → ACHETER │"
echo " │ │"
echo " └─────────────────────────────────────────────────────────────────┘"
echo ""

# ───────────────────────────────────────────────────────────────────────────
# ÉTAPE 4 — CALCUL DE L'ÉCART
# ───────────────────────────────────────────────────────────────────────────
printf "${C}═══ ÉTAPE 4 : CALCUL DE L'ÉCART ═══${N}\n"
echo ""

ECART=$(calc_div "$COUT_SIGNAL_1M" "$PRIX_GEMINI_CACHE_1M")

printf " Coût signal brut : \$%s / 1M\n" "$(fmt2 "$COUT_SIGNAL_1M")"
printf " Coût Gemini cache : \$%s / 1M\n" "$(fmt2 "$PRIX_GEMINI_CACHE_1M")"
printf " Coût Gemini input : \$%s / 1M\n" "$(fmt2 "$PRIX_GEMINI_INPUT_1M")"
printf " Coût DeepSeek cache : \$%s / 1M\n" "$(fmt2 "$PRIX_DEEPSEEK_CACHE_1M")"
echo ""
printf " ${W}ÉCART = %s / %s = ${R}%sx${N}\n" \
"$(fmt2 "$COUT_SIGNAL_1M")" "$(fmt2 "$PRIX_GEMINI_CACHE_1M")" "$(fmt2 "$ECART")"
echo ""

if [ "$(echo "$ECART > 1" | bc)" = "1" ]; then
printf " ${R}❌ Ton signal brut est %sx PLUS CHER que Gemini cache${N}\n" "$(fmt2 "$ECART")"
VERDICT="NE PAS ACHETER"
RAISON="Signal brut trop cher"
else
printf " ${G}✅ Ton signal brut est moins cher que Gemini cache${N}\n"
VERDICT="ACHETER"
RAISON="Signal brut compétitif"
fi
echo ""

# ───────────────────────────────────────────────────────────────────────────
# ÉTAPE 5 — SOLUTION POUR QUE ÇA MARCHE
# ───────────────────────────────────────────────────────────────────────────
printf "${C}═══ ÉTAPE 5 : SOLUTION POUR QUE ÇA MARCHE ═══${N}\n"
echo ""

echo " ┌─────────────────────────────────────────────────────────────────┐"
echo " │ 🎯 SOLUTION 1 : UTILISER LE CACHE (GRATUIT) │"
echo " │ │"
echo " │ Ne PAS acheter de signal brut. │"
echo " │ Utiliser le cache Gemini : │"
echo " │ • 90% de réduction (Gemini 2.5) │"
echo " │ • 95% de réduction (Gemini 4 Argon) │"
echo " │ • 60% de réduction (DeepSeek Flash) │"
echo " │ │"
echo " │ Économie annuelle estimée : \$%s │" \
"$(fmt2 "$(calc_mul "$(calc "$COUT_SIGNAL_1M - $PRIX_GEMINI_CACHE_1M")" "12")")"
echo " │ │"
echo " └─────────────────────────────────────────────────────────────────┘"
echo ""

echo " ┌─────────────────────────────────────────────────────────────────┐"
echo " │ 🎯 SOLUTION 2 : NÉGOCIER LE PRIX │"
echo " │ │"
echo " │ Prix actuel : \$%s / 1M │" \
"$(fmt2 "$COUT_SIGNAL_1M")"
echo " │ Prix max : \$%s / 1M │" \
"$(fmt2 "$PRIX_GEMINI_CACHE_1M")"
echo " │ Réduction : %s%% │" \
"$(fmt2 "$(calc "$(calc_div "$COUT_SIGNAL_1M" "$PRIX_GEMINI_CACHE_1M")" "100" | tr -d '-')")"
echo " │ │"
echo " │ Exiger : \$0.01 / 1k tokens (soit \$10 / 1M) │"
echo " │ │"
echo " └─────────────────────────────────────────────────────────────────┘"
echo ""

echo " ┌─────────────────────────────────────────────────────────────────┐"
echo " │ 🎯 SOLUTION 3 : COMPRESSER DAVANTAGE │"
echo " │ │"
echo " │ Γ actuel : %s │" \
"$(fmt4 "$GAMMA")"
echo " │ Γ cible : 8.33 │"
echo " │ Gain : %s%% │" \
"$(fmt2 "$(calc_mul "$(calc "$(calc_div 8.33 "$GAMMA")" "100")" "1")")"
echo " │ │"
echo " │ Si Γ = 8.33 : │"
echo " │ Tokens_final = 8000 / 8.33 = 960 │"
echo " │ Coût divisé par 4.17 │"
echo " │ │"
echo " └─────────────────────────────────────────────────────────────────┘"
echo ""

# ───────────────────────────────────────────────────────────────────────────
# ÉTAPE 6 — VERDICT FINAL
# ───────────────────────────────────────────────────────────────────────────
printf "${C}═══ ÉTAPE 6 : VERDICT FINAL ═══${N}\n"
echo ""

printf " ${W}🎯 DÉCISION : ${R}%s${N}\n" "$VERDICT"
printf " 📋 Raison : %s\n" "$RAISON"
printf " 🎲 Certitude: 95%%\n"
echo ""

printf " ${G}✅ VRAI${N} :\n"
printf " • Gemini cache (90%%) — PAS compression\n"
printf " • Argon cache (95%%)\n"
printf " • DeepSeek cache (60%%)\n"
printf " • Ton signal brut est %sx plus cher\n" "$(fmt2 "$ECART")"
echo ""

printf " ${C}📐 ÉQUATION À RETENIR :${N}\n"
echo " S_pur = Tokens_orig × (1/Γ) × Seuil_sémantique"
echo ""
echo " Écart = Coût_signal_brut / Coût_gemini_cache"
echo " Si Écart > 1 → NE PAS ACHETER"
echo ""

# ───────────────────────────────────────────────────────────────────────────
# SAUVEGARDE RAPPORT
# ───────────────────────────────────────────────────────────────────────────
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
REPORT_JSON="$REPORT_DIR/equation_$TIMESTAMP.json"

cat > "$REPORT_JSON" <<EOF
{
"version": "$VERSION",
"timestamp": "$(date -Iseconds)",
"auteur": "$AUTEUR",
"metriques": {
"gamma": $(fmt4 "$GAMMA"),
"rho": $(fmt6 "$RHO"),
"zeta": $(fmt4 "$ZETA"),
"signal_pur": $(fmt2 "$SIGNAL_PUR")
},
"couts": {
"signal_brut_1m": $(fmt2 "$COUT_SIGNAL_1M"),
"gemini_cache_1m": $(fmt2 "$PRIX_GEMINI_CACHE_1M"),
"gemini_input_1m": $(fmt2 "$PRIX_GEMINI_INPUT_1M"),
"deepseek_cache_1m": $(fmt2 "$PRIX_DEEPSEEK_CACHE_1M"),
"ecart": $(fmt2 "$ECART")
},
"verdict": {
"decision": "$VERDICT",
"raison": "$RAISON",
"certitude": "95%"
},
"equations": {
"signal": "S_pur = Tokens_orig × (1/Γ) × Seuil_sémantique",
"rentabilite": "Profit = Revenu - Coût",
"verite": "Ecart = Cout_signal_brut / Cout_gemini_cache"
},
"solutions": [
"Utiliser le cache Gemini (gratuit, 90% réduction)",
"Négocier le prix à \$0.01/1k tokens",
"Compresser davantage (Γ cible = 8.33)"
]
}
EOF

echo "═══════════════════════════════════════════════════════════════════════════"
printf " ${G}✅ ANALYSE TERMINÉE${N}\n"
echo "═══════════════════════════════════════════════════════════════════════════"
echo ""
printf " 📄 Rapport : %s\n" "$REPORT_JSON"
echo ""
